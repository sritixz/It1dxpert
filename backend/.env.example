# Database connection (Prisma requires this PostgreSQL URL)
DATABASE_URL="postgresql://username:password@localhost:5432/it1dxpert?schema=public"

# Server Port
PORT=5000

# Environment (development or production)
NODE_ENV="development"

# CORS configuration (comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost:5173"

# JWT Authentication Secrets
# WARNING: Change these to strong, unique secrets in production!
JWT_ACCESS_SECRET="your_jwt_access_secret_change_me_in_production"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_change_me_in_production"

# JWT Expiration times (optional, defaults to 15m and 7d)
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
