// -----------------------------------------------------------------------------
// iT1DXpert / DiabetesCare — Prisma schema
//
// Full schema: auth/RBAC + patient logging (glucose/insulin/meals/activity)
// + medications/adherence + rule-based alerts + appointments + gamification
// (streaks/badges). Every patient-owned row carries both patientId and
// hospitalId so multi-tenant scoping (see scopeToHospital middleware) can
// be enforced at the query level everywhere, not just on the profile tables.
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  PATIENT
}

enum DiabetesType {
  TYPE_1
  TYPE_2 // kept for flexibility even though current focus is Type 1
}

enum DoseStatus {
  UPCOMING
  TAKEN
  MISSED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum AppointmentMode {
  VIDEO_CALL
  IN_CLINIC
}

// -----------------------------------------------------------------------------
// Tenancy + auth
// -----------------------------------------------------------------------------

model Hospital {
  id           String   @id @default(uuid())
  name         String
  address      String?
  contactEmail String?
  contactPhone String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  patients     PatientProfile[]
  doctors      DoctorProfile[]
  glucoseLogs  GlucoseLog[]
  insulinLogs  InsulinLog[]
  mealLogs     MealLog[]
  activityLogs ActivityLog[]
  notes        PatientNote[]
  medications  Medication[]
  alerts       Alert[]
  appointments Appointment[]
  supportTickets SupportTicket[]

  @@map("hospitals")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)

  // Nullable because SUPER_ADMIN is platform-wide. Every other role MUST
  // have a hospitalId — enforced in the application layer.
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])

  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?
  supportTickets SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId])
  @@map("users")
}

model PatientProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  fullName      String
  dateOfBirth   DateTime?
  gender        String?
  diabetesType  DiabetesType @default(TYPE_1)
  diagnosisDate DateTime?

  assignedDoctorId String?
  assignedDoctor   DoctorProfile? @relation(fields: [assignedDoctorId], references: [id])

  glucoseLogs   GlucoseLog[]
  insulinLogs   InsulinLog[]
  mealLogs      MealLog[]
  activityLogs  ActivityLog[]
  notes         PatientNote[]
  medications   Medication[]
  alerts        Alert[]
  appointments  Appointment[]
  streakRecord  StreakRecord?
  patientBadges PatientBadge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId])
  @@index([assignedDoctorId])
  @@map("patient_profiles")
}

model DoctorProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  fullName       String
  specialization String?
  licenseNumber  String?

  // Clinic/Practice Details (Settings screen). Deliberately kept on the
  // doctor's own profile, not the Hospital record — this is the doctor's
  // own display info (e.g. a private practice name), separate from the
  // multi-tenant Hospital entity that only HOSPITAL_ADMIN/SUPER_ADMIN manage.
  clinicName        String?
  clinicAddress     String?
  consultationType  String? // e.g. "Both Online & In-Clinic", "In-Clinic Only"
  timezone          String? @default("Asia/Kolkata")

  // Notification Preferences (Settings screen) — which events generate an
  // in-app notification for this doctor. Defaults match the reference
  // mockup's defaults (everything on except appointment reminders).
  notifyHighGlucose     Boolean @default(true)
  notifyLowGlucose      Boolean @default(true)
  notifyMissedLogs      Boolean @default(true)
  notifyNewMessages     Boolean @default(true)
  notifyAppointments    Boolean @default(false)

  // Alert Preferences — configurable thresholds (Settings screen). Nullable:
  // null means "use the platform-wide defaults in alert.service.js", so a
  // doctor who's never touched this screen gets sensible defaults rather
  // than null-value bugs. Only meaningfully differs from the fixed
  // constants once a doctor explicitly sets their own.
  highGlucoseThreshold   Float?
  lowGlucoseThreshold    Float?
  urgentHighThreshold    Float?
  urgentLowThreshold     Float?

  // Alert delivery channel preferences. NOTE: only "in-app" is actually
  // wired to real delivery right now — email/SMS/WhatsApp are stored as
  // preferences but have no sending infrastructure behind them yet. Storing
  // the preference now means the UI/data model is ready; actual delivery
  // is separate infrastructure work (email needs a mail provider, SMS needs
  // a gateway, WhatsApp needs the Meta Business API already discussed).
  alertDeliveryInApp    Boolean @default(true)
  alertDeliveryEmail    Boolean @default(true)
  alertDeliverySms      Boolean @default(true)
  alertDeliveryWhatsApp Boolean @default(true)

  patients     PatientProfile[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId])
  @@map("doctor_profiles")
}

// -----------------------------------------------------------------------------
// Patient logging (Daily Log / Glucose Trends screens)
// -----------------------------------------------------------------------------

model GlucoseLog {
  id         String   @id @default(uuid())
  patientId  String
  patient    PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  value    Float // mg/dL
  context  String? // e.g. "pre-lunch", "post-dinner"
  loggedAt DateTime @default(now())

  @@index([patientId, loggedAt])
  @@map("glucose_logs")
}

model InsulinLog {
  id         String   @id @default(uuid())
  patientId  String
  patient    PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  units       Float
  insulinType String? // e.g. "rapid-acting", "long-acting"
  loggedAt    DateTime @default(now())

  @@index([patientId, loggedAt])
  @@map("insulin_logs")
}

model MealLog {
  id         String   @id @default(uuid())
  patientId  String
  patient    PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  carbs    Float // grams
  mealType String? // breakfast/lunch/dinner/snack
  notes    String?
  loggedAt DateTime @default(now())

  @@index([patientId, loggedAt])
  @@map("meal_logs")
}

model ActivityLog {
  id         String   @id @default(uuid())
  patientId  String
  patient    PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  durationMins Int
  activityType String?
  loggedAt     DateTime @default(now())

  @@index([patientId, loggedAt])
  @@map("activity_logs")
}

// -----------------------------------------------------------------------------
// Patient notes — free-text entries (e.g. "felt tired in the evening"), shown
// alongside logs in the doctor's merged event timeline. Didn't exist before
// this phase; added specifically to support the Glucose Monitor screen's
// "Recent Events" timeline from the reference mockups.
// -----------------------------------------------------------------------------

model PatientNote {
  id         String   @id @default(uuid())
  patientId  String
  patient    PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  content  String
  loggedAt DateTime @default(now())

  @@index([patientId, loggedAt])
  @@map("patient_notes")
}

// -----------------------------------------------------------------------------
// Medications (Medications screen)
// -----------------------------------------------------------------------------

model Medication {
  id         String   @id @default(uuid())
  patientId  String
  patient    PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  name           String
  dose           String // e.g. "16 units", "500mg" — kept as text, units vary too much for a pure number
  frequency      String // e.g. "Once daily", "Before meals"
  scheduledTimes String[] // e.g. ["08:00", "20:00"]
  purpose        String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  doses MedicationDose[]

  @@index([patientId])
  @@map("medications")
}

// A dose EVENT (taken/missed), not a schedule template — logged directly by
// the patient tapping "taken" rather than requiring a cron job to
// pre-generate rows for every scheduled time. Keeps this phase simple;
// a scheduler can be layered on top later without changing this shape.
model MedicationDose {
  id           String     @id @default(uuid())
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  patientId    String
  scheduledFor DateTime
  takenAt      DateTime?
  status       DoseStatus @default(TAKEN)

  @@index([patientId, scheduledFor])
  @@map("medication_doses")
}

// -----------------------------------------------------------------------------
// Alerts — rule-based threshold flags only (no AI), per the compliance
// decision to keep this a monitoring tool, not a clinical advisory one.
// -----------------------------------------------------------------------------

model Alert {
  id         String   @id @default(uuid())
  patientId  String
  patient    PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  type       String // "HIGH_GLUCOSE" | "LOW_GLUCOSE" | "MISSED_LOG"
  severity   AlertSeverity
  message    String
  // Separate from isResolved deliberately — "read" just means a doctor has
  // seen it (dismisses the New badge); "resolved" means the situation is
  // actually handled. The reference mockup treats these as different
  // actions (New/Read status column vs. a separate resolve action).
  isRead     Boolean  @default(false)
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([patientId, createdAt])
  @@map("alerts")
}

// -----------------------------------------------------------------------------
// Appointments
// -----------------------------------------------------------------------------

model Appointment {
  id         String   @id @default(uuid())
  patientId  String
  patient    PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId   String
  doctor     DoctorProfile @relation(fields: [doctorId], references: [id])
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  scheduledAt DateTime
  type        String            @default("Follow-up") // "Follow-up" | "Consultation"
  purpose     String? // e.g. "Routine Checkup", "Insulin Adjustment"
  // "Video Call" is a label only right now — no real video-call
  // infrastructure (Zoom/Meet link generation, etc.) is wired up. Storing
  // the mode lets the UI show the right icon/label; actually joining a
  // call is out of scope until a real video provider decision is made.
  mode        AppointmentMode   @default(IN_CLINIC)
  status      AppointmentStatus @default(PENDING)
  notes       String?
  createdAt   DateTime          @default(now())

  @@index([patientId, scheduledAt])
  @@index([doctorId, scheduledAt])
  @@map("appointments")
}

// -----------------------------------------------------------------------------
// Support tickets — Help & Support screen's "Submit a Ticket" feature.
// Deliberately not scoped to a role (any authenticated user can submit
// one) since the need to contact support isn't specific to patients or
// doctors. No auto-routing/triage logic — just storage for now; an admin
// would need to review these directly (e.g. via Prisma Studio) until an
// actual support-ticket admin view is built.
// -----------------------------------------------------------------------------

model SupportTicket {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])

  subject String
  message String
  status  String   @default("OPEN") // "OPEN" | "IN_PROGRESS" | "RESOLVED"
  createdAt DateTime @default(now())

  @@index([hospitalId, status])
  @@map("support_tickets")
}

// -----------------------------------------------------------------------------
// Gamification — confirmed as required, tied to daily-logging adherence.
// -----------------------------------------------------------------------------

model StreakRecord {
  id             String    @id @default(uuid())
  patientId      String    @unique
  patient        PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastLoggedDate DateTime?

  @@map("streak_records")
}

model Badge {
  id          String @id @default(uuid())
  code        String @unique // stable identifier used in gamification logic, e.g. "STREAK_7"
  name        String
  description String
  icon        String?

  patientBadges PatientBadge[]

  @@map("badges")
}

model PatientBadge {
  id        String   @id @default(uuid())
  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  earnedAt  DateTime @default(now())

  @@unique([patientId, badgeId]) // can't earn the same badge twice
  @@map("patient_badges")
}
